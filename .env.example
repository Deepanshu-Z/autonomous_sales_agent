# ============================================================
# WhatsApp Bot — Environment Variables Template
# Copy this file to .env and fill in your real values
# ============================================================

# --- WhatsApp / Meta ---
WHATSAPP_TOKEN=your_whatsapp_token_here
VERIFY_TOKEN=your_verify_token_here
PHONE_NUMBER_ID=your_phone_number_id

# --- Meta (Facebook & Instagram Comments + DMs) ---
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token
META_VERIFY_TOKEN=your_meta_webhook_verify_token
META_APP_SECRET=your_meta_app_secret
META_PAGE_ID=your_meta_page_id

# --- AI / LLM ---
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# --- Supabase (Database) ---
SUPABASE_URL=https://your-project.supabase.co/
SUPABASE_KEY=your_supabase_anon_key

# --- Interakt (WhatsApp Business API) ---
INTERAKT_API_KEY=your_interakt_api_key_base64
INTERAKT_WEBHOOK_SECRET=your_webhook_secret_uuid

# --- Qdrant (Vector DB) ---
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# --- Redis (Option 1: Self-Hosted on AWS/Local - RECOMMENDED for 100% power & unlimited commands) ---
REDIS_URL=redis://localhost:6379

# --- Redis (Option 2: Upstash Cloud - Optional) ---
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# --- Agent Assignment ---
PRIORITY_AGENT_EMAIL=agent@example.com
PRIORITY_AGENT_EMAIL_ANOTHER=escalation_agent@example.com

# --- Ad Targeting ---
# The Facebook Ad ID that triggers the bot (BOTH ad ID + message text must match)
TARGET_AD_ID=your_facebook_ad_id_here
# The pre-filled message text from the ad (must match exactly, case-insensitive)
TARGET_MESSAGE_TEXT=Hello! Can I get more info on Yoga classes?

# --- Optional ---
AGENT_CALL_NUMBER=91XXXXXXXXXX
SUPPORT_NOTIFY_NUMBER=91XXXXXXXXXX
ALLOWED_TEST_NUMBERS=91XXXXXXXXXX
TEST_MODE=False
ENABLE_CSV_LOGGING=False

# --- Rate Limiter (Independent Service) ---
RATE_LIMIT_ENABLED=True
RATE_LIMIT_MAX_MESSAGES=15
RATE_LIMIT_WINDOW_SECONDS=60

# --- Razorpay Payment Gateway ---
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

