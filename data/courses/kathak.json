        "rhythm_and_taal": [
            "Understanding Teentaal (16 beats)",
            "Reciting Bols (Padhant)",
            "Toda, Tukda, and Tihai",
            "Laya (Tempo) Variations"
        ],
        "expressions": [
            "Introduction to Abhinaya",
            "Navarasa (Nine Emotions)",
            "Facial Expressions for Storytelling",
            "Gat Nikas (Graceful Walks)"
        ],
